# Python build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.idea/

# Secrets
.env

# macOS junk
.DS_Store

# Data (recordings, transcripts, voice profiles — confidential)
# Default: ignore everything in data/, then make targeted exceptions.
#
# Layout is now per tenant: data/tenants/<slug>/{meetings,voice_profiles}/
# (scripts/migrate_tenant_fs.py). The rules below MUST follow it — under the
# old data/meetings/* rules the layout README silently stopped being tracked
# the moment the folders moved.
data/*
!data/tenants/
data/tenants/*
!data/tenants/*/

# Per tenant: allow the two folders through, then ignore their contents.
data/tenants/*/*
!data/tenants/*/meetings/
!data/tenants/*/voice_profiles/

# Inside meetings/, show that per-meeting subfolders exist and commit only
# the layout README; everything else (audio, transcripts, protocols) is private.
data/tenants/*/meetings/*
!data/tenants/*/meetings/README.md
!data/tenants/*/meetings/*/
data/tenants/*/meetings/*/*

# Voice profiles: each .npy is a person's biometric voice signature.
data/tenants/*/voice_profiles/*

# dev service logs (restart_dev.sh)
logs/

# Cutover backups (contain the DB and a copy of .env — never commit)
backups/
