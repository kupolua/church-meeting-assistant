# =================================================================
# Church Meeting Assistant — Environment Variables
# =================================================================
# Copy this file to .env and fill in real values.
# .env should be in .gitignore (do not commit secrets).
# =================================================================


# ─────────────────────────────────────────────────────────────
# Existing (from Phase 2A/2B)
# ─────────────────────────────────────────────────────────────

# Local embeddings + rerank (replaced Voyage — fully local, no API key)
#   Embeddings: bge-m3 via Ollama  →  ollama pull bge-m3
#   Rerank:     bge-reranker-v2-m3 via sentence-transformers (downloads on 1st use)
EMBED_MODEL=bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto                # auto → mps (Apple Silicon) / cuda / cpu; or force one

# Hugging Face (pyannote-audio; also used to download the reranker)
HF_TOKEN=your_huggingface_token_here


# ─────────────────────────────────────────────────────────────
# NEW: Database (Phase 3 / MVP-A)
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cma
DB_USER=cma
DB_PASSWORD=changeme_to_strong_random_password

# Constructed DATABASE_URL (asyncpg format)
# Example: postgresql://cma:changeme@127.0.0.1:5432/cma
# (built by code from above, but exposed here as fallback)
# DATABASE_URL=postgresql://cma:changeme_to_strong_random_password@127.0.0.1:5432/cma


# ─────────────────────────────────────────────────────────────
# NEW: Telegram bot (Phase 3 / MVP-A)
# ─────────────────────────────────────────────────────────────

# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Pavlo's Telegram user ID (numeric)
# To get: send any message to bot, look at logs (bot will log unknown user_id)
PAVLO_TELEGRAM_USER_ID=

# Bot polling timeout (long polling, seconds)
TELEGRAM_POLL_TIMEOUT=30


# ─────────────────────────────────────────────────────────────
# NEW: Service URLs (Phase 3 / MVP-A)
# ─────────────────────────────────────────────────────────────

# Ollama (local M1)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT=600  # seconds; Gemma can be slow

# Qdrant (Docker)
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT=30


# ─────────────────────────────────────────────────────────────
# NEW: Worker config (Phase 3 / MVP-A)
# ─────────────────────────────────────────────────────────────

# Polling intervals (seconds)
WORKER_POLL_INTERVAL=10           # When idle, check for pending
WORKER_HEALTH_CHECK_INTERVAL=60   # Health check frequency
WORKER_RETRY_SLEEP=60             # When Ollama/Qdrant down, wait this long

# Retry policy
WORKER_MAX_RETRIES=3


# ─────────────────────────────────────────────────────────────
# NEW: Ingestion worker config (MVP-C — audio → protocol)
# ─────────────────────────────────────────────────────────────
# Separate background worker (church_assistant.ingestion.main) that drives the
# long audio → protocol pipeline. Runs alongside the query worker.

INGESTION_POLL_INTERVAL=15         # When idle, check for runnable jobs
INGESTION_HEALTH_CHECK_INTERVAL=60 # Health snapshot frequency (gating only)
INGESTION_RETRY_SLEEP=60           # When Ollama/Qdrant down, wait this long

# Retry policy — pipeline steps are expensive, so keep this low
INGESTION_MAX_RETRIES=2

# Run diarization + transcription sequentially (lower peak RAM; slower)
INGESTION_SEQUENTIAL=false

# Auto-index the finished protocol into Qdrant (full cycle)
INGESTION_AUTO_INDEX=true


# ─────────────────────────────────────────────────────────────
# NEW: Web authentication (MT Phase 3 — multi-tenancy)
# ─────────────────────────────────────────────────────────────
# Signs the session cookie. A guessable key = forgeable tenant_id = one church
# reading another's protocols. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs everyone out (the emergency lever).
WEB_SECRET_KEY=

# Two independent session limits, both enforced in resolve_web_session():
#   TTL          — ABSOLUTE cap from sign-in; never extended (default 12 h)
#   IDLE_TIMEOUT — from LAST USE; covers a session left open on a shared machine
# Keep IDLE_TIMEOUT in hours: last_seen_at is only refreshed once a minute, so a
# short window would sign out people who are actively working. 0 disables it.
WEB_SESSION_TTL=43200
WEB_SESSION_IDLE_TIMEOUT=7200

# Secure flag on the session cookie, and whether to send HSTS.
#   auto (default) — Secure exactly when the request arrived over https
#   true           — always; correct behind a TLS-terminating proxy this app
#                    cannot see through. Plain-http clients then cannot log in
#                    at all, which is the intended failure.
#   false          — never; the plain-HTTP LAN setup.
# 'auto' only tells the truth behind a proxy if uvicorn runs with --proxy-headers
# (and --forwarded-allow-ips); otherwise every request looks like http.
WEB_COOKIE_SECURE=auto

# Root of per-tenant artifacts: <DATA_ROOT>/tenants/<slug>/{meetings,voice_profiles}
# Default: the repo's data/ directory.
# DATA_ROOT=/var/lib/cma/data

# Slug of the tenant whose data predates multi-tenancy. Its filesystem folders
# (data/meetings, data/voice_profiles) and Qdrant collections (cma_*) keep their
# legacy locations so the existing corpus needs no migration or re-index.
LEGACY_TENANT_SLUG=default
