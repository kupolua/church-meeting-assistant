# WireGuard on the DL165 ("ai") — the processing node, behind the home router.
#
#   sudo cp wg0.ai.conf.example /etc/wireguard/wg0.conf
#   sudo chmod 600 /etc/wireguard/wg0.conf
#   sudo systemctl enable --now wg-quick@wg0     # comes back after a reboot

[Interface]
Address    = 10.10.0.3/24
PrivateKey = <AI_PRIVATE_KEY>

[Peer]
PublicKey  = <VPS_PUBLIC_KEY>
Endpoint   = <VPS_PUBLIC_IP>:51820

# ONLY the tunnel subnet. 0.0.0.0/0 here would send every packet the server
# sends — apt, model downloads, everything — through the VPS, which is neither
# wanted nor what this is for.
AllowedIPs = 10.10.0.0/24

# The server sits behind the home router's NAT, so the mapping has to be kept
# warm or the VPS loses the way back and a running transcription stops being
# able to report progress. 25s is the WireGuard convention.
PersistentKeepalive = 25
