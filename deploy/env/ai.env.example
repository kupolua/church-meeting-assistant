# The processing node after the move off the laptop: the DL165 G7 ("ai",
# 2× Opteron 6276, 64 GB, RX 580 8 GB) at 10.10.0.3 on the tunnel.
#
# Start from the M1's .env (it already has the DB password, the HF token and
# CMA_PROCESSOR_KEY) and apply these lines over it. The secrets move with the
# role: this box now decrypts the encrypted churches' artifacts, the laptop no
# longer needs to.
#
#   cp deploy/env/ai.env.example /srv/cma/.env    # then edit
#   chmod 600 /srv/cma/.env

# ─── Same control plane as from the M1 ───────────────────────
DB_HOST=10.10.0.1
DB_PORT=5432
DB_NAME=cma
DB_USER=cma_app
DB_PASSWORD=<CMA_APP_PASSWORD>
QDRANT_URL=http://10.10.0.1:6333

# ─── Models ──────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
# No MPS here and no usable CUDA/ROCm: the reranker runs on the CPU.
RERANK_DEVICE=cpu

# Whisper runs on the RX 580 through whisper.cpp + Vulkan. faster-whisper (the
# M1's engine) cannot reach this GPU and is 3× slower than real time on these
# CPUs; whisper.cpp on the card is 3× faster than real time. Same JSON out.
WHISPER_BACKEND=whisper-cpp
WHISPER_CPP_BIN=/home/kpl/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/home/kpl/whisper.cpp/models/ggml-large-v3-q8_0.bin
WHISPER_CPP_THREADS=4

# ─── Which phases this host claims ───────────────────────────
# Both, since 2026-10-08: the cutover went transcription first, then analysis
# once gemma4:26b (a 26B-A4B MoE, so the CPUs cope: ~8 tok/s) was proven here.
# Set 'transcription' alone to hand the Gemma phase back to another host.
INGESTION_PHASES=transcription,analysis

# ─── Where the meeting folders are reached ───────────────────
# A local scratch copy; the VPS holds the authoritative one and artifact_sync
# copies at phase boundaries (docs/vps_deploy.md §7).
DATA_ROOT=/srv/cma/data
ARTIFACT_SYNC_REMOTE=cma@10.10.0.1:/srv/cma-data/artifacts

# ─── Only the workers run here ───────────────────────────────
CMA_ROLE=worker
