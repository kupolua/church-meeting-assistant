# /srv/cma/.env on the VPS — the control plane.
#
# What is NOT here is the point: no OLLAMA_URL, no EMBED_MODEL, no RERANK_*.
# Since fc781a9 the web tier never runs a model — every question goes onto the
# `queries` queue and the M1 worker answers it — so this box needs no weights,
# no torch, and none of the 8 GB it does not have.
#
# ⚠️ NO INLINE COMMENTS AFTER A VALUE. systemd's EnvironmentFile treats `#` as a
# comment ONLY at the start of a line, so `DB_PORT=5432  # note` sets the port to
# the whole string including the note, and libpq answers with
#     missing "=" after "#" in connection info string
# The trap is that the same line works on the laptop: python-dotenv does strip
# inline comments, but load_dotenv() does not override an environment systemd has
# already polluted. Keep every comment on its own line.
#
# For the same reason, quote any value that legitimately contains `#`:
#     DB_PASSWORD='pa#ssword'

# ─── Database (container on this host, tunnel-bound) ─────────
DB_HOST=10.10.0.1
# 5432, not the M1's 5433 — that number only exists because langfuse already
# holds 5432 on the laptop. Nothing competes for it here.
DB_PORT=5432
DB_NAME=cma
# MUST be cma_app, never cma: the superuser bypasses row-level security and
# every church would then see every other church's rows.
DB_USER=cma_app
# NOT a free choice. roles.sql carries `ALTER ROLE cma_app ... PASSWORD '<hash>'`
# from the M1, so after the import this role has the M1's password whatever you
# put here. Read it off the laptop: grep '^DB_PASSWORD=' .env
DB_PASSWORD=<CMA_APP_PASSWORD_FROM_M1>

# Also NOT a free choice, for a less obvious reason. The container creates this
# role at first boot with whatever is here, and then the import runs
# `ALTER ROLE cma ... PASSWORD '<hash>'` — which SUCCEEDS and overwrites it with
# the M1's. (The CREATE ROLE fails harmlessly; the ALTER does not.) Put the M1's
# value here or the compose file will claim one password while reality has
# another. Read it off the laptop:
#   docker inspect cma-postgres --format '{{range .Config.Env}}{{println .}}{{end}}' | grep POSTGRES_PASSWORD
#
# Rotating both to fresh values is the right end state — but do it AFTER cutover
# proves out, as a separate step: the M1's workers log in as cma_app against
# this database, so a rotation has to land on both sides at once.
POSTGRES_SUPERUSER_PASSWORD=<SUPERUSER_PASSWORD_FROM_M1>

# ─── Qdrant (container on this host, tunnel-bound) ───────────
QDRANT_URL=http://10.10.0.1:6333
QDRANT_TIMEOUT=30

# ─── Web ─────────────────────────────────────────────────────
# The one value here that IS yours to choose — and it must be new. Every session
# on the laptop is signed with its key; sharing one across machines makes a
# single leak into two breaches. Generate it on this box:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=<GENERATE_A_NEW_ONE_ON_THE_VPS>
WEB_SESSION_TTL=43200
WEB_SESSION_IDLE_TIMEOUT=7200
# TRUE here, unlike the laptop: there is TLS in front of this one, and a session
# cookie that will travel over plain HTTP is a session cookie someone can take.
WEB_COOKIE_SECURE=true

# ─── Artifacts ───────────────────────────────────────────────
# Audio, transcripts and protocols. Ministers keep access to the recording
# after the protocol exists (decision of 2026-08-24), so audio is NOT deleted
# after processing and this grows by ~68 MB per meeting. See docs/vps_deploy.md
# step 8 for what to watch.
DATA_ROOT=/srv/cma/data

# Must stay 'default' — it maps the existing corpus onto the cma_* collections.
# Clearing it points the archive at collections that do not exist.
LEGACY_TENANT_SLUG=default

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
PAVLO_TELEGRAM_USER_ID=<TELEGRAM_USER_ID>
TELEGRAM_POLL_TIMEOUT=30
