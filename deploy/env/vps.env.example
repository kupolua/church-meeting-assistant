# /srv/cma/.env on the VPS — the control plane.
#
# What is NOT here is the point: no OLLAMA_URL, no EMBED_MODEL, no RERANK_*.
# Since fc781a9 the web tier never runs a model — every question goes onto the
# `queries` queue and the M1 worker answers it — so this box needs no weights,
# no torch, and none of the 8 GB it does not have.

# ─── Database (container on this host, tunnel-bound) ─────────
DB_HOST=10.10.0.1
DB_PORT=5432                  # not 5433 — that number only exists because
                              # langfuse holds 5432 on the laptop
DB_NAME=cma
# MUST be cma_app, never cma: the superuser bypasses row-level security and
# every church would then see every other church's rows.
DB_USER=cma_app
DB_PASSWORD=<CMA_APP_PASSWORD>

# Superuser password for the postgres container itself, read by
# deploy/docker-compose.vps.yml. Not used by the application.
POSTGRES_SUPERUSER_PASSWORD=<POSTGRES_SUPERUSER_PASSWORD>

# ─── Qdrant (container on this host, tunnel-bound) ───────────
QDRANT_URL=http://10.10.0.1:6333
QDRANT_TIMEOUT=30

# ─── Web ─────────────────────────────────────────────────────
# Generate fresh, do NOT copy the laptop's: every existing session is signed
# with it, and reusing a key across machines means one leak is two breaches.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=<GENERATE_A_NEW_ONE>
WEB_SESSION_TTL=43200
WEB_SESSION_IDLE_TIMEOUT=7200
# TRUE here, unlike the laptop: there is TLS in front of this one, and a session
# cookie that will travel over plain HTTP is a session cookie someone can take.
WEB_COOKIE_SECURE=true

# ─── Artifacts ───────────────────────────────────────────────
# Audio, transcripts and protocols. Ministers keep access to the recording
# after the protocol exists (decision of 2026-08-24), so audio is NOT deleted
# after processing and this grows by ~68 MB per meeting. See docs/vps_deploy.md
# step 8 for what to watch.
DATA_ROOT=/srv/cma/data

# Must stay 'default' — it maps the existing corpus onto the cma_* collections.
# Clearing it points the archive at collections that do not exist.
LEGACY_TENANT_SLUG=default

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
PAVLO_TELEGRAM_USER_ID=<TELEGRAM_USER_ID>
TELEGRAM_POLL_TIMEOUT=30
